rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() {
      return request.auth != null;
    }

    function membreDe(foyerId) {
      return connecte()
        && request.auth.uid in get(/databases/$(database)/documents/foyers/$(foyerId)).data.membres;
    }

    match /utilisateurs/{uid} {
      allow read, write: if connecte() && request.auth.uid == uid;
    }

    match /foyers/{foyerId} {
      allow read: if connecte() && request.auth.uid in resource.data.membres;

      allow create: if connecte()
        && request.resource.data.membres == [request.auth.uid];

      allow update: if connecte() && (
        (request.auth.uid in resource.data.membres
          && request.auth.uid in request.resource.data.membres)
        || (!(request.auth.uid in resource.data.membres)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membres'])
          && request.resource.data.membres == resource.data.membres.concat([request.auth.uid])
          && request.resource.data.membres.size() <= 20)
      );

      allow delete: if false;

      match /{collection}/{docId} {
        allow read, write: if membreDe(foyerId);
      }
    }
  }
}
